{
  "name": "zatca-qr",
  "version": "1.0.1",
  "description": "ZATCA (Saudi FATOORA) e-invoice QR: encode, decode and validate in TLV + Base64. Byte-accurate Arabic text, zero dependencies. مولّد وقارئ رمز فاتورة زاتكا.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test",
    "demo": "node examples/node.mjs"
  },
  "keywords": [
    "zatca",
    "zatca-qr",
    "fatoora",
    "e-invoicing",
    "saudi-arabia",
    "vat",
    "qr",
    "qrcode",
    "qr-decoder",
    "tlv",
    "base64",
    "invoice",
    "validate",
    "arabic",
    "rtl",
    "ksa",
    "tax"
  ],
  "author": "VibeIO <hello@vibeio.dev>",
  "license": "MIT",
  "homepage": "https://www.vibeio.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exeerkit/zatca-qr.git"
  },
  "bugs": {
    "url": "https://github.com/exeerkit/zatca-qr/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
